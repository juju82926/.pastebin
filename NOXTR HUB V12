-- ============================================================
-- FUNCIÓN: CERRAR SCRIPT COMPLETO
-- ============================================================
local function CerrarScript()
    scriptActivo = false
    
    -- Parar todos los auto clickers
    for _, item in ipairs(teclasCreadas) do
        item.estado.activo = false
        if item.estado.conns then
            for _, conn in ipairs(item.estado.conns) do
                pcall(function() conn:Disconnect() end)
            end
        end
    end
    
    -- Destruir botones y limpiar
    for _, item in ipairs(teclasCreadas) do
        pcall(function() item.boton:Destroy() end)
    end
    table.clear(teclasCreadas)
    
    -- Destruir GUI completa (elimina TODO de golpe)
    pcall(function() ScreenGui:Destroy() end)
    
    print("[NOXTR] ✅ Script cerrado. Todo eliminado.")
end

-- ============================================================
-- ARRASTRE GENÉRICO
-- ============================================================
local function HacerArrastrable(boton)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local moved = false
    
    boton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = boton.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            if math.abs(delta.X) > 8 or math.abs(delta.Y) > 8 then
                moved = true
            end
            boton.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    return function() return moved end
end

local addMoved = HacerArrastrable(BotonAdd)
local quitarMoved = HacerArrastrable(BotonQuitar)

