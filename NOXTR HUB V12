-- ============================================================
-- FUNCIÓN: CREAR AUTO CLICKER
-- ============================================================
local function CrearTecla()
    if not scriptActivo then return end
    
    contadorTeclas += 1
    local id = contadorTeclas
    
    local posY = 160 + ((id - 1) % 6) * 80
    local posX = 50 + math.floor((id - 1) / 6) * 80
    
    local Tecla = Instance.new("TextButton")
    Tecla.Name = "AutoClicker_" .. id
    Tecla.Size = UDim2.new(0, 70, 0, 70)
    Tecla.Position = UDim2.new(0, posX, 0, posY)
    Tecla.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Tecla.Text = "▶"
    Tecla.TextColor3 = Color3.fromRGB(255, 255, 255)
    Tecla.Font = Enum.Font.GothamBold
    Tecla.TextSize = 28
    Tecla.BorderSizePixel = 0
    Tecla.Active = true
    Tecla.AutoButtonColor = false
    Tecla.Parent = ScreenGui
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = Tecla
    
    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(220, 40, 40)
    Stroke.Thickness = 3
    Stroke.Parent = Tecla
    
    local CpsLabel = Instance.new("TextLabel")
    CpsLabel.Size = UDim2.new(0, 70, 0, 18)
    CpsLabel.Position = UDim2.new(0, 0, 0, -20)
    CpsLabel.BackgroundTransparency = 1
    CpsLabel.Text = CPS_DEFAULT .. " CPS"
    CpsLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    CpsLabel.Font = Enum.Font.Gotham
    CpsLabel.TextSize = 12
    CpsLabel.Parent = Tecla
    
    local estado = {
        id = id,
        activo = false,
        cps = CPS_DEFAULT,
        intervalo = 1 / CPS_DEFAULT,
        dragging = false,
        dragStart = nil,
        startPos = nil,
        moved = false,
    }
    
    local function ObtenerCentro()
        local pos = Tecla.AbsolutePosition
        local size = Tecla.AbsoluteSize
        return pos.X + size.X / 2, pos.Y + size.Y / 2
    end
    
    local function clampPosition(pos)
        local viewport = workspace.CurrentCamera.ViewportSize
        local btnSize = Tecla.AbsoluteSize
        local x = math.clamp(pos.X.Offset, 0, viewport.X - btnSize.X)
        local y = math.clamp(pos.Y.Offset, 0, viewport.Y - btnSize.Y)
        return UDim2.new(0, x, 0, y)
    end
    
    Tecla.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            estado.dragging = true
            estado.moved = false
            estado.dragStart = input.Position
            estado.startPos = Tecla.Position
        end
    end)
    
    local connChanged = UserInputService.InputChanged:Connect(function(input)
        if not estado.dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - estado.dragStart
            if math.abs(delta.X) > 8 or math.abs(delta.Y) > 8 then
                estado.moved = true
            end
            local newPos = UDim2.new(
                estado.startPos.X.Scale, estado.startPos.X.Offset + delta.X,
                estado.startPos.Y.Scale, estado.startPos.Y.Offset + delta.Y
            )
            Tecla.Position = clampPosition(newPos)
        end
    end)
    
    local connEnded = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            estado.dragging = false
        end
    end)
    
    estado.conns = {connChanged, connEnded}
    
    task.spawn(function()
        while Tecla.Parent and scriptActivo do
            if estado.activo then
                local t0 = tick()
                local x, y = ObtenerCentro()
                HacerClicEn(x, y)
                local elapsed = tick() - t0
                local waitTime = estado.intervalo - elapsed
                if waitTime > 0 then
                    task.wait(waitTime)
                end
            else
                task.wait(0.05)
            end
        end
    end)
    
    Tecla.MouseButton1Click:Connect(function()
        if estado.moved or not scriptActivo then return end
        
        estado.activo = not estado.activo
        if estado.activo then
            Tecla.Text = "⏹"
            Stroke.Color = Color3.fromRGB(90, 220, 130)
            Stroke.Thickness = 3
        else
            Tecla.Text = "▶"
            Stroke.Color = Color3.fromRGB(220, 40, 40)
            Stroke.Thickness = 3
        end
    end)
    
    Tecla.MouseButton2Click:Connect(function()
        if not scriptActivo then return end
        local valores = {5, 10, 15, 20, 30, 50, 100}
        local idx = 1
        for i, v in ipairs(valores) do
            if v == estado.cps then idx = i break end
        end
        idx = idx % #valores + 1
        estado.cps = valores[idx]
        estado.intervalo = 1 / estado.cps
        CpsLabel.Text = estado.cps .. " CPS"
    end)
    
    table.insert(teclasCreadas, {
        boton = Tecla,
        estado = estado,
    })
    
    ActualizarContador()
    return Tecla
end

-- ============================================================
-- FUNCIÓN: QUITAR LA ÚLTIMA TECLA
-- ============================================================
local function QuitarUltimaTecla()
    if #teclasCreadas == 0 then
        print("[NOXTR] No hay auto clickers para quitar")
        return
    end
    
    local ultima = table.remove(teclasCreadas)
    
    if ultima.estado.conns then
        for _, conn in ipairs(ultima.estado.conns) do
            pcall(function() conn:Disconnect() end)
        end
    end
    
    ultima.boton:Destroy()
    ActualizarContador()
end

